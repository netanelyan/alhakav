# Copy to private/.env on the server (private/ is never committed). Comments go on their own lines.

# The server listens on 127.0.0.1 behind Caddy
PORT=4760
DB_FILE=private/leads.db

# The admin's password, as a hash: npm run admin:password
ADMIN_PASSWORD_HASH=
# 64 random hex characters; npm run admin:password prints one
SESSION_SECRET=

# Finding leads: a Google Maps key with the Places API (New) on, whose listings come with the phone and the site;
# the Brave Search API key, for sites; how many searches run each morning (0 turns the daily run off); and how many
# new leads one run adds at most. Either key is enough, and with both Google goes first.
GOOGLE_MAPS_KEY=
BRAVE_API_KEY=
DISCOVER_QUERIES=3
DISCOVER_LIMIT=30

# המוקדן, the second number on the same WhatsApp Business Account: it writes to every customer's callers and sends them
# their summaries (docs/connecting.md). Its Meta phone number id, and its digits (972...)
ASSIST_PHONE_ID=
ASSIST_NUMBER=

# Sending from the business number (WhatsApp Cloud API). Until META_TOKEN and META_PHONE_ID are set, the admin page
# offers copy-and-open from your own phone instead.
META_TOKEN=
META_PHONE_ID=
META_WABA_ID=
# For the webhook at /meta/webhook: the Meta app's secret, and any string you also type in the app's webhook settings
META_APP_SECRET=
META_VERIFY_TOKEN=
# The business number's two-step verification PIN, set when it was registered (README); alhakav does not read it
META_PIN=

# The approved templates (docs/whatsapp-templates.md)
TEMPLATE_FIRST=alhakav_page
TEMPLATE_REMINDER=alhakav_page_reminder
# The identification line at the end of both templates, exactly as approved (name, full name, address, site)
SENDER_LINE=
# The landing page, sent after someone presses "כן, שלחו"
SITE_URL=
# First messages and reminders from the business number a day, at most
OUTREACH_DAILY=10

# ---- The service: each customer's own number on Telnyx, voice only, where their calls are forwarded (docs/connecting.md)
TELNYX_API_KEY=
# The account's public key (Keys & Credentials), for the webhooks' Ed25519 signatures
TELNYX_PUBLIC_KEY=
# המוקדן's templates, on the business number's WhatsApp Business Account
TEMPLATE_CALLER=alhakav_caller
TEMPLATE_SUMMARY=alhakav_summary
# The note when a caller did not answer: empty picks alhakav_call_alert once Meta approves it as Utility, else
# alhakav_call_note (meta.js pickTemplate); a name here is used alone.
TEMPLATE_NOTE=
# An mp3 the forwarded call plays before it ends; empty: the call ends at once
GREETING_URL=
# Minutes without an answer before the customer gets the note or the summary
SUMMARY_WAIT_MINUTES=20
# ---- Paying (docs/payments.md), on the business number above
# The transfer details in one line, as the customer reads them; unset, no payment message goes
PAYMENT_DETAILS=
TEMPLATE_PAYMENT=alhakav_payment
# Morning (Green Invoice): the business's API keys; MORNING_ENV=sandbox for Morning's sandbox. Unset, no invoice is
# issued automatically
MORNING_CLIENT_ID=
MORNING_CLIENT_SECRET=
MORNING_ENV=

# Claude, which talks with the callers (claude-sonnet-5-5 unless CLAUDE_MODEL says otherwise, e.g. claude-opus-5-5)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# The owner's own WhatsApp (05X or 9725X): the alerts about leads, sales and payments, and the evening summary, go to it
# from the business number (server/alerts.js): plain text while they wrote to it in the last 24 hours, else the template.
# Unset, or until the template is approved, the alerts go through Toran (below).
OWNER_WA=
# Empty picks alhakav_owner_alert once Meta approves it as Utility, else alhakav_update; a name here is used alone.
TEMPLATE_UPDATE=
# Alerts to the owner in an hour, at most, and the Israel hour the day's summary goes from (server/digest.js)
ALERTS_HOURLY=20
DIGEST_HOUR=19

# Toran answers on the business number, and the admin's alerts go to their WhatsApp through it (docs/toran.md). The
# token is the one in openfrequency-toran's private/.env. Unset, nobody answers by itself: someone new gets the
# explanation once, and the admin answers from the lead's page.
OF_INTERNAL_TOKEN=
TORAN_URL=http://127.0.0.1:4710
# The company store's domain in Toran; SITE_URL's host when unset
TORAN_DOMAIN=
TORAN_DEBOUNCE_MS=3000

# The scheduled task that writes to tradespeople (docs/autopilot.md): its key (openssl rand -hex 24), 1 to let it send,
# and how many first messages it sends in a half day (the day's cap is OUTREACH_DAILY).
AUTOPILOT_TOKEN=
AUTOPILOT=
AUTOPILOT_BATCH=5

# A customer's own number, bought at Telnyx when their payment is approved (server/numbers.js): the voice app's id,
# the requirement group with our business's documents (Telnyx asks for it on every Israeli number), and the limits.
TELNYX_CONNECTION_ID=
TELNYX_REQUIREMENT_GROUP=
NUMBERS_PER_MONTH=5
NUMBER_MAX_USD=5
